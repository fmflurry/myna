{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myna",
  "version": "0.1.0",
  "identifier": "app.myna.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "title": "Myna",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**/*", "$APPDATA/**/*", "$HOME/myna/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "publisher": "Myna",
    "copyright": "Copyright © 2026 Myna. MIT licensed.",
    "category": "Productivity",
    "shortDescription": "Local-first AI meeting recorder and summarizer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../templates": "templates",
      "../../scripts": "scripts"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQ0M4Q0I3OTA3MEI0NTIKUldSU3RIQ1F0NHpNczAzK3JiV0tyMkhQZi9TMjh1SmgydjBBQURvRzFFQnIrc1F4UWtmU05kSXAK",
      "endpoints": ["https://github.com/fmflurry/myna/releases/latest/download/latest.json"]
    }
  }
}
