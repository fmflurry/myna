{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myna",
  "version": "0.1.0",
  "identifier": "app.myna.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "title": "Myna",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**/*", "$APPDATA/**/*", "$HOME/myna/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../templates": "templates"
    },
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-"
    }
  }
}
