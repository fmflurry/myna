# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Node
node_modules/
dist/

# Rust
target/

# Model artifacts (downloaded via `hf download`) — only README.md tracked
models/*
!models/README.md

# Logs
*.log

# Environment
.env

# Local runtime data (machine-local; never commit)
data/

# Database artifacts
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Frontend (Angular UI)
/node_modules
/ui/.angular
/lcov.info

# Defence-in-depth: this app records real meetings and downloads model
# weights. CLAUDE.md documents `recordings/meeting.wav` /
# `recordings/meeting.txt` as working paths — catch any recording or model
# artifact placed outside the already-ignored `models/`/`data/` dirs before
# it can be staged and pushed to a public repo.
recordings/
*.wav
*.gguf
*.onnx

# Tauri updater signing key: the private minisign keypair used to sign
# updater artifacts must NEVER enter git history. Public keys are baked
# into `tauri.conf.json`, not committed as loose files.
*.key
*.key.pub
.tauri/
minisign*.key
